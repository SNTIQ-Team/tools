   "commands": [
    {
     "item": 1,
     "new_text": "b) deren Aufenthaltsrecht sich allein aus dem Zweck der Arbeitsuche, der Ausbildungs- oder Studienplatzsuche \noder aus einer Aufenthaltserlaubnis nach § 20a des Aufenthaltsgesetzes ergibt,",
     "old_text_constraint": null,
     "operation": "replace",
     "raw": "§ 7 Absatz 1 Satz 2 Nummer 2 Buchstabe b des Zweiten Buches Sozialgesetzbuch – Bürgergeld, \nGrundsicherung für Arbeitsuchende – in der Fassung der Bekanntmachung vom 13. Mai 2011 (BGBl. I S. 850, \n2094), das zuletzt durch Artikel 5 des Gesetzes vom 17. Juli 2023 (BGBl. 2023 I Nr. 191) geändert worden ist, \nwird wie folgt gefasst:\n„b) deren Aufenthaltsrecht sich allein aus dem Zweck der Arbeitsuche, der Ausbildungs- oder Studienplatzsuche \noder aus einer Aufenthaltserlaubnis nach § 20a des Aufenthaltsgesetzes ergibt,“.",
     "ref": {
      "absatz": "1",
      "buchstabe": "b",
      "nummer": "2",
      "para": "7",
      "satz": "2"
     },
     "text": "§ 7 Absatz 1 Satz 2 Nummer 2 Buchstabe b des Zweiten Buches Sozialgesetzbuch – Bürgergeld, Grundsicherung für Arbeitsuchende – in der Fassung der Bekanntmachung vom 13. Mai 2011 (BGBl. I S. 850, 2094), das zuletzt durch Artikel 5 des Gesetzes vom 17. Juli 2023 (BGBl. 2023 I Nr. 191) geändert worden ist, wird wie folgt gefasst: „b) deren Aufenthaltsrecht sich allein aus dem Zweck der Arbeitsuche, der Ausbildungs- oder Studienplatzsuche oder aus einer Aufenthaltserlaubnis nach § 20a des Aufenthaltsgesetzes ergibt,“."
    }
   ]
  },
